<script define:vars={{ content }}>
  const root = document.querySelector('.page');
  const languageButtons = document.querySelectorAll('[data-lang-btn]');

  function getValue(object, path) {
    return path
      .split('.')
      .reduce((current, part) => current && current[part], object);
  }

  function setLanguage(language) {
    if (!content[language]) return;

    root?.setAttribute('data-lang', language);
    document.documentElement.lang = language;

    document.querySelectorAll('[data-i18n]').forEach((element) => {
      const key = element.getAttribute('data-i18n');
      const value = getValue(content[language], key);

      if (typeof value === 'string') {
        element.textContent = value;
      }
    });

    document.querySelectorAll('[data-i18n-list]').forEach((element) => {
      const key = element.getAttribute('data-i18n-list');
      const value = getValue(content[language], key);

      if (typeof value === 'string') {
        element.textContent = value;
      }
    });

    document
      .querySelectorAll('[data-i18n-placeholder]')
      .forEach((element) => {
        const key = element.getAttribute('data-i18n-placeholder');
        const value = getValue(content[language], key);

        if (typeof value === 'string') {
          element.setAttribute('placeholder', value);
        }
      });

    languageButtons.forEach((button) => {
      button.classList.toggle(
        'active',
        button.getAttribute('data-lang-btn') === language
      );
    });

    localStorage.setItem('portfolio-lang', language);
  }

  const savedLanguage =
    localStorage.getItem('portfolio-lang') || 'ru';

  setLanguage(savedLanguage);

  languageButtons.forEach((button) => {
    button.addEventListener('click', () => {
      setLanguage(button.getAttribute('data-lang-btn'));
    });
  });

  const feedbackModal = document.getElementById('feedbackModal');
  const openFeedbackModal = document.getElementById('openFeedbackModal');
  const closeFeedbackModal = document.getElementById('closeFeedbackModal');
  const feedbackBackdrop = document.getElementById('feedbackBackdrop');

  function openModal() {
    feedbackModal?.classList.add('is-open');
    feedbackModal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    feedbackModal?.classList.remove('is-open');
    feedbackModal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  openFeedbackModal?.addEventListener('click', openModal);
  closeFeedbackModal?.addEventListener('click', closeModal);
  feedbackBackdrop?.addEventListener('click', closeModal);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeModal();
    }
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    },
    {
      threshold: 0.08,
    }
  );

  document
    .querySelectorAll(
      '.section, .experience-row, .project, .skill-column'
    )
    .forEach((element) => {
      element.classList.add('reveal');
      observer.observe(element);
    });
</script>

